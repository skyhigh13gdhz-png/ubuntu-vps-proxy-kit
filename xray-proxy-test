#!/usr/bin/env bash
set -u

SOCKS="127.0.0.1:10808"
HTTP="http://127.0.0.1:10809"
FAILED=0

ok(){ printf '[✓] %s\n' "$*"; }
fail(){ printf '[✗] %s\n' "$*"; FAILED=1; }

check_http() {
  local label="$1" mode="$2" url="$3" status
  if [[ "$mode" == "socks" ]]; then
    status="$(curl -o /dev/null -sS -w '%{http_code}' --max-time 20 --socks5-hostname "$SOCKS" "$url" 2>/dev/null || true)"
  else
    status="$(curl -o /dev/null -sS -w '%{http_code}' --max-time 20 -x "$HTTP" "$url" 2>/dev/null || true)"
  fi
  if [[ "$status" =~ ^(200|204|301|302|307|308|401)$ ]]; then ok "$label：可访问（HTTP $status）"; else fail "$label：访问失败（${status:-无响应}）"; fi
}

echo '========== 海外网络检查 =========='
if systemctl is-active --quiet xray 2>/dev/null; then ok 'Xray 服务：正常'; else fail 'Xray 服务：异常'; fi
check_http 'Google' socks 'https://www.google.com/'
check_http 'GitHub' http 'https://github.com/'
check_http 'Docker Registry' http 'https://registry-1.docker.io/v2/'

PROXY_IP="$(curl -4fsS --max-time 20 --socks5-hostname "$SOCKS" https://api.ipify.org 2>/dev/null || true)"
if [[ -n "$PROXY_IP" ]]; then ok "海外出口：已生效（${PROXY_IP}）"; else fail '海外出口：无法确认'; fi

echo
if [[ "$FAILED" -eq 0 ]]; then
  ok '海外网络配置完成'
else
  fail '海外网络配置未通过，请先处理上面的失败项'
  echo '[→] 排障日志：sudo journalctl -u xray -n 50 --no-pager'
fi
exit "$FAILED"
