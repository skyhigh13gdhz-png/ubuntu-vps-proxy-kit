#!/usr/bin/env bash
set -u

SOCKS="127.0.0.1:10808"
HTTP="http://127.0.0.1:10809"
FAILED=0

shell_proxy_state() {
  local value
  for value in "${http_proxy:-}" "${https_proxy:-}" "${HTTP_PROXY:-}" "${HTTPS_PROXY:-}" "${ALL_PROXY:-}" "${all_proxy:-}"; do
    case "$value" in
      *127.0.0.1:10808*|*127.0.0.1:10809*)
        echo "ON"
        return
        ;;
    esac
  done
  echo "OFF"
}

check_http() {
  local label="$1" mode="$2" url="$3" status
  if [[ "$mode" == "socks" ]]; then
    status="$(curl -o /dev/null -sS -w '%{http_code}' --max-time 20 --socks5-hostname "$SOCKS" "$url" 2>/dev/null || true)"
  else
    status="$(curl -o /dev/null -sS -w '%{http_code}' --max-time 20 -x "$HTTP" "$url" 2>/dev/null || true)"
  fi

  if [[ "$status" =~ ^(200|204|301|302|307|308)$ ]]; then
    printf '%-23s OK (%s)\n' "$label:" "$status"
  else
    printf '%-23s FAILED (%s)\n' "$label:" "${status:-no response}"
    FAILED=1
  fi
}

SHELL_PROXY="$(shell_proxy_state)"
printf '%-23s %s\n' "Shell auto-proxy:" "$SHELL_PROXY"

if systemctl is-active --quiet xray 2>/dev/null; then
  printf '%-23s OK\n' "Xray service:"
else
  printf '%-23s FAILED\n' "Xray service:"
  FAILED=1
fi

echo
echo "Xray path check (forced through local proxy; independent of proxy_on/proxy_off):"
check_http "Google via Xray" socks "https://www.google.com/"
check_http "GitHub via Xray" http "https://github.com/"

PROXY_IP="$(curl -4fsS --max-time 20 --socks5-hostname "$SOCKS" https://api.ipify.org 2>/dev/null || true)"
if [[ -n "$PROXY_IP" ]]; then
  printf '%-23s %s\n' "Xray exit IP:" "$PROXY_IP"
else
  printf '%-23s FAILED\n' "Xray exit IP:"
  FAILED=1
fi

echo
if [[ "$SHELL_PROXY" == "ON" ]]; then
  echo "Shell meaning: ordinary commands in THIS shell can automatically use Xray."
else
  echo "Shell meaning: ordinary commands in THIS shell are NOT automatically using Xray."
fi
echo "Note: the Xray checks above explicitly select the local proxy, so they can succeed even when Shell auto-proxy is OFF."

if [[ "$FAILED" -eq 0 ]]; then
  echo "RESULT: Xray proxy path is healthy."
else
  echo "RESULT: one or more Xray path checks failed."
  echo "Logs: journalctl -u xray -n 100 --no-pager"
fi

exit "$FAILED"
